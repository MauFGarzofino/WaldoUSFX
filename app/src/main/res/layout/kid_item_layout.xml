<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/kid_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/teddy_bear"
        android:layout_marginEnd="8dp"
        android:contentDescription="image" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/kid_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Niño"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_color" />

        <TextView
            android:id="@+id/kid_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado de conexión"
            android:textSize="14sp"
            android:textColor="@color/subtext_color" />
    </LinearLayout>
    <Button
        android:id="@+id/ButtonHistoryKid"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/history"
        android:backgroundTint="#17364D"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:textColor="#00445E"
        android:textColorLink="#00445E" />

    <Button
        android:id="@+id/unlink_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desvincular"
        android:textSize="14sp"
        android:paddingHorizontal="16dp"
        android:backgroundTint="#e76f7c"
        android:textColor="@android:color/white"
        android:layout_marginStart="8dp" />
</LinearLayout>
